# ==================================================
# PrepAI Environment Configuration
# ==================================================

# Database Configuration (Defaults to local SQLite if omitted)
# For local dev without Postgres: sqlite:///./prepai.db
# For PostgreSQL / Docker: postgresql://prepai_user:prepai_password@localhost:5432/prepai_db
DATABASE_URL=sqlite:///./prepai.db

# Authentication / JWT
JWT_SECRET=change-this-to-a-very-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM Provider Selection (options: openai, anthropic, gemini, groq, local)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Provider API Keys (leave blank to run in intelligent parser fallback mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings & Vector Search (options: local, openai)
EMBEDDING_PROVIDER=local

# Audio / Speech Integration
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=
